# Copy to .env and fill in your values. Never commit the real .env.

# LLM model (single source of truth, provider/model format via LiteLLM).
MODEL=groq/llama-3.3-70b-versatile

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Observability (optional)
LOG_LEVEL=INFO                  # DEBUG for verbose app logs
CREWAI_TRACING_ENABLED=false    # true to enable CrewAI execution traces

# Langfuse LLM tracing (optional). Requires: uv sync --group tracing
# Get keys at https://cloud.langfuse.com (or self-host).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
